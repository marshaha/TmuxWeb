# Copy this file to .env and replace every example value.
TMUX_WEB_PASSWORD=replace-with-a-long-random-password
TMUX_WEB_SESSION_SECRET=replace-with-output-of-python3-c-import-secrets-print-secrets-token-hex-32
TMUX_WEB_HOST=127.0.0.1
TMUX_WEB_PORT=8787
# auto: Secure cookies on HTTPS requests; set true when TLS terminates at a proxy that does not forward the scheme.
TMUX_WEB_SECURE_COOKIES=auto

# Optional: long-lived token for programmatic clients (relay_client.py, other agents).
# Leave empty to disable token auth. Generate with: python3 -c 'import secrets;print(secrets.token_urlsafe(32))'
# TMUX_WEB_API_TOKEN=

# Optional: SSH connection multiplexing for remote hosts (default on). One
# authenticated connection is reused for capture, transcript and terminal traffic.
# TMUX_WEB_SSH_MUX=1
# TMUX_WEB_SSH_MUX_DIR=/run/user/1000/tmuxweb-mux
# Locale forced on remote hosts so tmux does not rewrite non-ASCII pane text.
# TMUX_WEB_REMOTE_LC=C.UTF-8

# Optional file transfer limits (bytes). Transfers are buffered in memory.
# TMUX_WEB_FILE_DOWNLOAD_MAX=67108864
# TMUX_WEB_FILE_UPLOAD_MAX=268435456
# 多选打包下载（解压后大小上限 / 文件数上限 / 远端打包超时秒数）
# TMUX_WEB_ZIP_MAX=134217728
# TMUX_WEB_ZIP_MAX_FILES=1000
# MCP 端点 /mcp 是否要求 Bearer token；内网部署可设 off（此时任何能访问端口的人都能操作 pane）
# TMUX_WEB_MCP_AUTH=off

# Optional runtime state locations. Keep these outside a public repository when possible.
# TMUX_WEB_HOST_DB=/var/lib/tmuxweb/remote_hosts.db
# TMUX_WEB_HOST_KEY=/var/lib/tmuxweb/remote_hosts.key
# TMUX_WEB_SHARE_DB=/var/lib/tmuxweb/shares.db
# Favourites and dashboard cards for the /home board (sqlite)
TMUX_WEB_HOME_DB=home.db


# 放在 Cloudflare / nginx 反向代理后面时：
#   - 信任 CF-Connecting-IP / X-Forwarded-*：登录限速按真实客户端计数，cookie 也按 X-Forwarded-Proto 判 Secure
#   - 只允许这些域名访问（逗号分隔；127.0.0.1 / localhost 始终放行）
# TMUX_WEB_TRUST_PROXY=1
# TMUX_WEB_ALLOWED_HOSTS=chat.example.com
# TMUX_WEB_SECURE_COOKIES=true

# Maximum number of transcript messages a single request may return (paging ceiling).
TMUX_WEB_TRANSCRIPT_LIMIT_MAX=3000

# Force the tmux binary used on remote hosts (checked once, otherwise auto-detected).
# TMUX_WEB_TMUX_PATH=/opt/homebrew/bin/tmux
