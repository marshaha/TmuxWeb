# Copy this file to .env and replace every example value.
TMUX_WEB_PASSWORD=replace-with-a-long-random-password
TMUX_WEB_SESSION_SECRET=replace-with-output-of-python3-c-import-secrets-print-secrets-token-hex-32
TMUX_WEB_HOST=127.0.0.1
TMUX_WEB_PORT=8787
# auto: Secure cookies on HTTPS requests; set true when TLS terminates at a proxy that does not forward the scheme.
TMUX_WEB_SECURE_COOKIES=auto

# Optional runtime state locations. Keep these outside a public repository when possible.
# TMUX_WEB_HOST_DB=/var/lib/tmuxweb/remote_hosts.db
# TMUX_WEB_HOST_KEY=/var/lib/tmuxweb/remote_hosts.key
# TMUX_WEB_SHARE_DB=/var/lib/tmuxweb/shares.db
