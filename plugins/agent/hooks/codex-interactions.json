{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/tmuxweb-agent/hooks/observe.py codex"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/tmuxweb-agent/hooks/observe.py codex"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/tmuxweb-agent/hooks/observe.py codex"
          }
        ]
      }
    ]
  }
}
