{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/tmuxweb-agent/hooks/observe.py claude"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/tmuxweb-agent/hooks/observe.py claude"
          }
        ],
        "matcher": "AskUserQuestion"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/tmuxweb-agent/hooks/observe.py claude"
          }
        ],
        "matcher": "AskUserQuestion"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/tmuxweb-agent/hooks/observe.py claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/tmuxweb-agent/hooks/observe.py claude"
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/tmuxweb-agent/hooks/observe.py claude"
          }
        ]
      }
    ],
    "ElicitationResult": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/tmuxweb-agent/hooks/observe.py claude"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/tmuxweb-agent/hooks/observe.py claude"
          }
        ]
      }
    ]
  }
}
